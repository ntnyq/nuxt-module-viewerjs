{
  "name": "@nuxt-dev/viewerjs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.7.0",
  "description": "Viewer.js integrated for Nuxt",
  "keywords": [
    "Viewer.js",
    "image",
    "nuxt",
    "nuxt-module",
    "nuxt3",
    "nuxt4",
    "viewerjs"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://nuxt-module-viewerjs.ntnyq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/nuxt-module-viewerjs.git"
  },
  "bugs": {
    "url": "https://github.com/ntnyq/nuxt-module-viewerjs/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "deploy": "run-s dev:prepare build play:build",
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint",
    "play:build": "nuxi generate playground",
    "play:dev": "nuxi dev playground",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest run",
    "typecheck": "run-s typecheck:module typecheck:playground",
    "typecheck:module": "tsc --noEmit",
    "typecheck:playground": "vue-tsc --build playground/tsconfig.json"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "defu": "^6.1.7",
    "viewerjs": "^1.15.0"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.22",
    "@ntnyq/prettier-config": "^3.1.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^26.6.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,vue,md,svg,yml,yaml,json}": "eslint --fix"
  }
}
